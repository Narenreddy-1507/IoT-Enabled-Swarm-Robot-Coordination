// ================= SCAN ================= 
void startScan() { 
  Serial.println("\n SCAN STARTED"); 
 
  // ===== SHOW SCANNING ===== 
  display.clearDisplay(); 
  display.setCursor(0,0); 
  display.println("Scanning..."); 
  display.display(); 
 
  // Reset slots 
  for (int i = 1; i <= 4; i++) slots[i] = -1; 
 
  // Send scan commands 
  sendCommand("GO_SLOT_1"); delay(2500); 
  sendCommand("GO_SLOT_2"); delay(2500); 
  sendCommand("GO_SLOT_3"); delay(2500); 
  sendCommand("GO_SLOT_4"); delay(2500); 
  sendCommand("STOP"); 
 
  delay(1500); 
 
  Serial.println("\n FINAL RESULT:"); 
 
  // ===== FINAL SLOT DISPLAY ONLY ===== 
  display.clearDisplay(); 
 
  display.setCursor(0,0); 
  display.print("S1:"); 
  display.print(slots[1]==0?"E":"F"); 
  display.print(" S2:"); 
  display.print(slots[2]==0?"E":"F"); 
 
  display.setCursor(0,10); 
  display.print("S3:"); 
  display.print(slots[3]==0?"E":"F"); 
  display.print(" S4:"); 
  display.print(slots[4]==0?"E":"F"); 
 
  display.display(); 
 
  // ===== FINAL DECISION (NO LCD DISPLAY) ===== 
  for (int i = 1; i <= 4; i++) { 
    if (slots[i] == 0) { 
 
      Serial.print(" GO TO SLOT "); 
      Serial.println(i); 
 
      if (i == 1) sendCommand("FINAL_SLOT_1"); 
      else if (i == 2) sendCommand("FINAL_SLOT_2"); 
      else if (i == 3) sendCommand("FINAL_SLOT_3"); 
      else if (i == 4) sendCommand("FINAL_SLOT_4"); 
 
      return; 
    } 
  } 
 
  Serial.println(" PARKING FULL"); 
} 
 
